generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  firstName    String?
  lastName     String?
  imageUrl     String?
  totalBalance Decimal  @default(0.00)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
